<Project>

  <!--
    MCPFab server Directory.Build.props.

    Copy this into an MCPSharp server repository root. These properties MUST live here
    rather than in the DnaX.MCPFab.Build package: the .NET SDK reads them before NuGet
    package props are imported, so a package that sets them has no effect at all - the
    generated MSBuild editorconfig never receives build_property.EnableTrimAnalyzer and
    the analyzer stays silent. DnaX.MCPFab.Build enforces that this block is present
    (MCPFAB003 / MCPFAB004) rather than trying to substitute for it.
  -->

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <Deterministic>true</Deterministic>
    <ContinuousIntegrationBuild Condition="'$(CI)' == 'true'">true</ContinuousIntegrationBuild>
    <AnalysisLevel>latest</AnalysisLevel>
  </PropertyGroup>

  <!--
    Trim analysis. Set McpFabTrimPolicy to Exempt in the csproj to opt a server out.

    Analysed in both tiers, but only Trimmed is strict. A server mid-migration still has its
    anonymous-type serialization sites, and every one of them is an IL2026/IL3050 - so if
    Analyzed also promoted those to errors, no server could ever adopt the staging tier and the
    migration would have to land in a single unreviewable change. Analyzed therefore reports
    them as warnings: the count is visible, the build succeeds, and the sites can be migrated
    incrementally. Flipping to Trimmed is what makes them errors.
  -->
  <PropertyGroup Condition="'$(McpFabTrimPolicy)' != 'Exempt'">
    <EnableTrimAnalyzer>true</EnableTrimAnalyzer>
    <!-- Analyzer only. IsAotCompatible stays off until a server actually publishes AOT. -->
    <EnableAotAnalyzer>true</EnableAotAnalyzer>
    <EnableSingleFileAnalyzer>true</EnableSingleFileAnalyzer>

    <!-- Interceptor-based generators; both replace reflection the trimmer cannot follow. -->
    <EnableConfigurationBindingGenerator>true</EnableConfigurationBindingGenerator>
    <EnableRequestDelegateGenerator>true</EnableRequestDelegateGenerator>
  </PropertyGroup>

  <PropertyGroup Condition="'$(McpFabTrimPolicy)' == 'Trimmed'">
    <!-- IsTrimmable asserts the assembly IS trim-safe, and promotes trim warnings to errors. -->
    <IsTrimmable>true</IsTrimmable>
    <!--
      Turns every remaining anonymous-type serialization site from a runtime {} into a
      build-time failure, rather than a server that starts and returns empty payloads.
    -->
    <JsonSerializerIsReflectionEnabledByDefault>false</JsonSerializerIsReflectionEnabledByDefault>
  </PropertyGroup>

  <ItemGroup Condition="'$(McpFabTrimPolicy)' != 'Exempt'">
    <!-- Enforces the banned-API list shipped by DnaX.MCPFab.Build. -->
    <!--
      No Version attribute: every MCPSharp server uses Central Package Management, which
      rejects a Version on PackageReference (NU1008). The consuming repository declares
      <PackageVersion Include="Microsoft.CodeAnalysis.BannedApiAnalyzers" ... /> instead.
    -->
    <PackageReference Include="Microsoft.CodeAnalysis.BannedApiAnalyzers">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
  </ItemGroup>

</Project>
