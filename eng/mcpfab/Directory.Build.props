<Project>

  <!--
    MCPFab server Directory.Build.props.

    Copy this into an MCPSharp server repository root and set McpFabTrimPolicy below.

    These properties MUST live here rather than in the DnaX.MCPFab.Build package: the .NET SDK
    reads them before NuGet package props are imported, so a package that sets them has no effect
    at all - the generated MSBuild editorconfig never receives build_property.EnableTrimAnalyzer
    and the analyzer stays silent. DnaX.MCPFab.Build enforces that this block is present
    (MCPFAB003) rather than trying to substitute for it.
  -->

  <!--
    ==========================================================================================
    Trim policy. This is the one place a server declares it.
    ==========================================================================================

      McpFabTrimPolicy
        Trimmed   Analysers on, and the self-contained publish is trimmed.
        Analyzed  Analysers on, ships untrimmed. The staging state while migrating, and the
                  right answer for a server whose payload sites are not all converted yet.
        Exempt    Analysers off. Requires McpFabTrimExemptionReason. For a dependency that
                  cannot be trimmed at all - RemoteAdminMCPSharp hosts PowerShell in-process,
                  PlaywrightMCPSharp uses Roslyn scripting.

      McpFabTrimMode (only read when the policy is Trimmed)
        partial   Trims assemblies marked IsTrimmable, which in practice is the framework.
                  This server's own code and its third-party dependencies are left whole.
                  Measured on RedisMCPSharp: released executable 49.7 MB -> 19.2 MB, with all
                  72 tools and 48 of 48 live tool calls byte-shape identical to untrimmed.
        full      Trims everything, which is smaller again but reaches into third-party
                  assemblies, where a reflective path becomes a runtime failure rather than a
                  build warning. Not yet exercised against any server in this estate.

    It is declared HERE, not in the csproj, and that is load-bearing. This file is imported
    before the csproj body, so a value set in the csproj is still empty when the conditions below
    are evaluated: the Trimmed block silently does nothing while DnaX.MCPFab.Build.targets,
    imported late enough to see it, fails the build. That is not hypothetical - it failed
    RedisMCPSharp v1.2.4's Docker job, because the Dockerfile runs its own dotnet publish with no
    global property to match.

    A -p: flag does work, because global properties are set before evaluation. Declaring it here
    is preferred for two plainer reasons: a local `dotnet build` then reproduces exactly what CI
    produces, and the policy is stated once in the repository rather than duplicated into a
    workflow file that can drift from it.

    Because of that, the release pipeline needs to know nothing about trimming. PublishTrimmed
    and TrimMode are set below rather than passed as workflow inputs.

    Note what this does NOT change: the container. The Dockerfile publishes framework-dependent
    onto the aspnet runtime base image, and PublishTrimmed requires a self-contained publish, so
    the SelfContained condition below correctly declines to set it. The image is the same size it
    always was - that is right, not a gap. Only the self-contained release assets are trimmed.
  -->
  <PropertyGroup>
    <McpFabTrimPolicy>Analyzed</McpFabTrimPolicy>
    <McpFabTrimMode>partial</McpFabTrimMode>
  </PropertyGroup>

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <Deterministic>true</Deterministic>
    <ContinuousIntegrationBuild Condition="'$(CI)' == 'true'">true</ContinuousIntegrationBuild>
    <AnalysisLevel>latest</AnalysisLevel>
  </PropertyGroup>

  <!--
    Analysed in every tier but Exempt, and only Trimmed is strict. A server mid-migration still
    has its anonymous-type serialization sites, and every one of them is an IL2026/IL3050 - so if
    Analyzed also promoted those to errors, no server could ever adopt the staging tier and the
    migration would have to land in a single unreviewable change. Analyzed therefore reports them
    as warnings: the count is visible, the build succeeds, and the sites can be migrated
    incrementally.
  -->
  <PropertyGroup Condition="'$(McpFabTrimPolicy)' != 'Exempt'">
    <EnableTrimAnalyzer>true</EnableTrimAnalyzer>
    <!-- Analyzer only. IsAotCompatible stays off until a server actually publishes AOT. -->
    <EnableAotAnalyzer>true</EnableAotAnalyzer>
    <EnableSingleFileAnalyzer>true</EnableSingleFileAnalyzer>

    <!-- Interceptor-based generators; both replace reflection the trimmer cannot follow. -->
    <EnableConfigurationBindingGenerator>true</EnableConfigurationBindingGenerator>
    <EnableRequestDelegateGenerator>true</EnableRequestDelegateGenerator>
  </PropertyGroup>

  <PropertyGroup Condition="'$(McpFabTrimPolicy)' == 'Trimmed'">
    <IsTrimmable>true</IsTrimmable>
    <!--
      Turns every remaining anonymous-type serialization site from a runtime {} into a loud
      failure, rather than a server that starts and returns empty payloads.
    -->
    <JsonSerializerIsReflectionEnabledByDefault>false</JsonSerializerIsReflectionEnabledByDefault>

    <!--
      PublishTrimmed requires a self-contained publish, so the framework-dependent legs opt out
      on their own rather than needing the pipeline to reason about it.
    -->
    <PublishTrimmed Condition="'$(SelfContained)' == 'true'">true</PublishTrimmed>
    <TrimMode Condition="'$(SelfContained)' == 'true'">$(McpFabTrimMode)</TrimMode>
  </PropertyGroup>

  <!--
    What this file actually saw, so DnaX.MCPFab.Build.targets can tell the difference between a
    policy declared here and one that arrived too late for the blocks above to act on. Without
    it the only available diagnosis is "copy the block into Directory.Build.props", which is
    wrong and misleading when the block is present and the csproj is what set the policy.
  -->
  <PropertyGroup>
    <_McpFabPolicyObservedInProps>$(McpFabTrimPolicy)</_McpFabPolicyObservedInProps>
  </PropertyGroup>

  <ItemGroup Condition="'$(McpFabTrimPolicy)' != 'Exempt'">
    <!-- Enforces the banned-API list shipped by DnaX.MCPFab.Build. -->
    <!--
      No Version attribute: every MCPSharp server uses Central Package Management, which
      rejects a Version on PackageReference (NU1008). The consuming repository declares
      <PackageVersion Include="Microsoft.CodeAnalysis.BannedApiAnalyzers" ... /> instead.
    -->
    <PackageReference Include="Microsoft.CodeAnalysis.BannedApiAnalyzers">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
  </ItemGroup>

</Project>
