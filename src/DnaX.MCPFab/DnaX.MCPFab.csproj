<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <PackageId>DnaX.MCPFab</PackageId>
    <Description>Host, configuration chain, logging, and authentication for MCPFab MCP servers.</Description>
    <IsTrimmable>true</IsTrimmable>
    <EnableTrimAnalyzer>true</EnableTrimAnalyzer>
    <EnableAotAnalyzer>true</EnableAotAnalyzer>
    <EnableSingleFileAnalyzer>true</EnableSingleFileAnalyzer>
    <!-- Interceptor-based; replaces reflection binding the trimmer cannot follow. -->
    <EnableConfigurationBindingGenerator>true</EnableConfigurationBindingGenerator>
  </PropertyGroup>
  <ItemGroup>
    <InternalsVisibleTo Include="DnaX.MCPFab.Tests" />
  </ItemGroup>
  <ItemGroup>
    <!-- The shared product icon, so no server needs its own EmbeddedResource entry. -->
    <EmbeddedResource Include="wmcp.ico" LogicalName="DnaX.MCPFab.wmcp.ico" />
  </ItemGroup>
  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="../DnaX.MCPFab.Abstractions/DnaX.MCPFab.Abstractions.csproj" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="ModelContextProtocol.AspNetCore" />
    <PackageReference Include="Microsoft.Extensions.Hosting.WindowsServices" />
    <PackageReference Include="Serilog.AspNetCore" />
    <PackageReference Include="Serilog.Sinks.Console" />
    <PackageReference Include="Serilog.Sinks.File" />
    <PackageReference Include="Serilog.Enrichers.Environment" />
    <PackageReference Include="Serilog.Enrichers.Process" />
    <PackageReference Include="Serilog.Enrichers.Thread" />
  </ItemGroup>
</Project>
